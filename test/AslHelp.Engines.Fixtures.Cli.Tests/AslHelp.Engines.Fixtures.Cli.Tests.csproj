<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ToolsPath)/AslHelp.Engines.Fixtures.Cli/AslHelp.Engines.Fixtures.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <!-- Embed the readme and the justfile, because tests compare their tables and pins with the code. -->
  <ItemGroup>
    <EmbeddedResource Include="$(RootPath)/justfile" LogicalName="justfile" />
    <EmbeddedResource Include="$(RootPath)/readme.md" LogicalName="readme.md" />
  </ItemGroup>

  <!-- Embed the rows of the fake toolchain, because the release reader reads them from the assembly of the row type. -->
  <ItemGroup>
    <EmbeddedResource Include="fake-releases.json" LogicalName="fake-releases.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Unreal4/install_engine_harness.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
