<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net4.8.1;net11.0-windows</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcPath)/AslHelp.Engines.Unreal/AslHelp.Engines.Unreal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AslHelp.Memory.Remote" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <!-- Link the player id and executable rules of the fixtures tools, because their project only targets net11.0-windows. -->
  <ItemGroup>
    <Compile Include="$(ToolsPath)/AslHelp.Engines.Fixtures/Unreal4/UnrealPlayerNames.cs" Link="Unreal4/UnrealPlayerNames.cs" />
  </ItemGroup>

  <!-- Embed the pinned UDK releases, so a test checks that the version parser knows the build of each. -->
  <ItemGroup>
    <EmbeddedResource Include="$(RootPath)/eng/fixtures/unreal3/releases.json" LogicalName="unreal3-releases.json" />
  </ItemGroup>

</Project>
