<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <AssemblyName>fixtures</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ToolsPath)/AslHelp.Engines.Fixtures/AslHelp.Engines.Fixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Docker.DotNet.Enhanced" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

  <!-- Copy only the class files, so a stray editor file next to them never changes the player key. -->
  <ItemGroup>
    <Content
      Include="$(TestPath)/fixtures/unreal3/Classes/*.uc"
      Link="projects/unreal3/Classes/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Embed the pin table, because only the code reads it.
      Copy the player classes to the output instead, because the cache key hashes those files on disk.
      Set LogicalName, so the resource name does not depend on RootNamespace.
    -->
    <EmbeddedResource Include="Unreal3/installers.json" LogicalName="Unreal3/installers.json" />
  </ItemGroup>

</Project>
