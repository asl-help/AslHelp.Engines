<Project>

  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Shared package versions. -->
  <ItemGroup>
    <PackageVersion Include="AslHelp.Memory" Version="0.1.0-alpha.1" />
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.3.3" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <!-- Test package versions. -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <!-- Global packages. -->
  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Polyfill" Version="1.0.168" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="5.0.0-1.25277.114" />
  </ItemGroup>

  <PropertyGroup>
    <MeziantouPolyfill_IncludedPolyfills>
      M:System.ArgumentNullException.ThrowIfNull(System.Object,System.String);
      T:System.Diagnostics.CodeAnalysis.NotNullAttribute;
      T:System.Runtime.CompilerServices.CallerArgumentExpressionAttribute;
      T:System.Runtime.CompilerServices.IsExternalInit;
    </MeziantouPolyfill_IncludedPolyfills>
  </PropertyGroup>

</Project>
