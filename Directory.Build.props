<Project>

  <!-- Shared paths. -->
  <PropertyGroup>
    <RootPath>$(MSBuildThisFileDirectory)</RootPath>

    <FixturesPath>$(RootPath)/eng/fixtures</FixturesPath>
    <ToolsPath>$(RootPath)/eng/tools</ToolsPath>
    <SrcPath>$(RootPath)/src</SrcPath>
    <TestPath>$(RootPath)/test</TestPath>

    <ArtifactsPath>$(RootPath)/artifacts</ArtifactsPath>
    <_PackageProps>$(MSBuildProjectDirectory)/$(MSBuildProjectName).Package.props</_PackageProps>
  </PropertyGroup>

  <!-- Shared properties. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Nullable>enable</Nullable>

    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Restore the Windows projects on Linux too, because CI checks the format there. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

  <!-- Packaging. -->
  <PropertyGroup Condition="Exists('$(_PackageProps)')">
    <IsPackable>true</IsPackable>

    <Authors>ero</Authors>
    <RepositoryUrl>https://github.com/asl-help/AslHelp.Engines</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageReleaseNotes>$(RepositoryUrl)/blob/main/changelog.md</PackageReleaseNotes>

    <PackageLicenseExpression>0BSD</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- CI. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <Import Condition="Exists('$(_PackageProps)')" Project="$(_PackageProps)" />

</Project>
